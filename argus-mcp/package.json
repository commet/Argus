{
  "name": "argus-decision-mcp",
  "version": "1.0.0",
  "description": "Argus decision-accountability MCP server — seal a falsifiable prediction, settle it against reality. Works with any MCP host (Claude, ChatGPT, Gemini).",
  "type": "module",
  "main": "dist/index.js",
  "mcpName": "io.github.commet/argus-decision-mcp",
  "bin": {
    "argus-decision-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prebuild": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval": "node evals/run.mjs",
    "eval:review": "node evals/run-review.mjs",
    "prepublishOnly": "npm run build && npm test",
    "eval:premises": "node evals/run-premises.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "decision-making",
    "accountability",
    "claude",
    "ai-tools"
  ],
  "license": "MIT",
  "author": "commet",
  "homepage": "https://argus.voyage",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/commet/argus.git",
    "directory": "argus-mcp"
  },
  "bugs": {
    "url": "https://github.com/commet/argus/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "js-yaml": "^4.1.0",
    "tinyld": "^1.3.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^4.1.9"
  }
}
