{
  "name": "argus",
  "version": "0.1.0",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "kernel:build": "npm --prefix argus-mcp run build",
    "postinstall": "npm --prefix argus-mcp ci --include=dev",
    "predev": "npm run kernel:build",
    "dev": "next dev",
    "prebuild": "npm run kernel:build",
    "build": "next build",
    "preflight:deploy": "node scripts/check-deploy-env.mjs",
    "dogfood": "npm run kernel:build && tsx scripts/dogfood/runner.ts",
    "dogfood:heavy": "npm run kernel:build && tsx scripts/dogfood/runner.ts --fuzz 2000 --repeat 3",
    "dogfood:prod": "npm run kernel:build && tsx scripts/dogfood/runner.ts --mode production",
    "dogfood:analyze": "tsx scripts/dogfood/analyze.ts",
    "experience:web": "node scripts/dogfood/experience/browser-walkthrough.mjs",
    "experience:web:selftest": "node scripts/dogfood/experience/_selftest.mjs",
    "experience:terminal": "node scripts/dogfood/experience/terminal-flow.mjs",
    "preflight:dogfood": "npm run build && npm test && npm run lint && npm run gates && npm run gates:test && npm run signals:test && npm run eval:static && node argus-plugin-v2/scripts/validate-plugin.js && node --check argus-plugin-v2/scripts/push-webapp.js && git diff --check",
    "start": "next start",
    "lint": "eslint src --max-warnings=145",
    "pretest": "npm run kernel:build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "eval": "node argus-plugin-v2/evals/run.mjs",
    "eval:static": "node argus-plugin-v2/evals/static-gate.test.mjs",
    "jcr:recall-bench": "tsx scripts/benchmark-recall.ts",
    "gates": "node argus-plugin-v2/scripts/validate-gates.mjs",
    "gates:test": "node argus-plugin-v2/scripts/validate-gates.test.mjs",
    "signals:test": "node argus-plugin-v2/scripts/test-decision-signals.mjs",
    "validate:progressive": "tsx --env-file=.env.local scripts/validate-progressive.ts",
    "probe:boss": "tsx --env-file=.env.local scripts/probe-boss-store.ts",
    "validate:boss": "tsx --env-file=.env.local scripts/validate-boss.ts",
    "eval:sweep": "node argus-plugin-v2/evals/sweep.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@google/genai": "^1.48.0",
    "@marsidev/react-turnstile": "^1.5.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "@supabase/supabase-js": "^2.99.2",
    "framer-motion": "^12.38.0",
    "jszip": "^3.10.1",
    "lucide-react": "^0.577.0",
    "mammoth": "^1.12.0",
    "next": "^16.2.2",
    "openai": "^6.33.0",
    "pdfjs-dist": "^6.1.200",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "^6.9.4",
    "ssaju": "^0.1.1",
    "three": "^0.183.2",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "jsdom": "^29.0.1",
    "playwright": "^1.60.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "postcss": "8.5.16"
  }
}
