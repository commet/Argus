# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic API Key (optional — only needed for proxy mode)
# Set this via your hosting provider (Vercel, etc.), NOT in .env.local
# ANTHROPIC_API_KEY=sk-ant-...

# Slack integration (optional — Settings > Connect to Slack stays off without these)
# SLACK_CLIENT_ID=            # Slack app OAuth client ID
# SLACK_CLIENT_SECRET=        # Slack app OAuth client secret
# SLACK_SIGNING_SECRET=       # Slack app signing secret (also signs the OAuth state)

# Email (optional — used by /api/email/send-question to ask external people)
# RESEND_API_KEY=             # Resend API key for outbound email
# EMAIL_INBOUND_SECRET=       # Shared secret for the inbound reply webhook; without it, replies are not auto-reflected

# Web search (optional — /api/search returns { disabled: true } without it)
# BRAVE_SEARCH_API_KEY=       # Brave Search API subscription token

# Cron (recommended in production — protects /api/cron/* endpoints)
# CRON_SECRET=                # Random string; Vercel sends it as a Bearer token on cron invocations
