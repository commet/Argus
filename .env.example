# Supabase (required)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Required by public shares, account deletion/export, sync, and cron jobs.
# Never expose this value through NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Core production service
ANTHROPIC_API_KEY=sk-ant-...
NEXT_PUBLIC_SITE_URL=https://argus.voyage
CRON_SECRET=replace-with-a-long-random-secret

# Return loop email (required for the promised check-in/reminder flow)
RESEND_API_KEY=re_...
EMAIL_FROM_DOMAIN=argus.voyage
# EMAIL_REPLY_TO=hello@argus.voyage
# REPORT_EMAIL=owner@example.com
# OWNER_EMAILS=owner@example.com

# Abuse protection (recommended; signup works without it but has less protection)
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Slack integration (optional — Settings > Connect to Slack stays off without these)
# SLACK_CLIENT_ID=            # Slack app OAuth client ID
# SLACK_CLIENT_SECRET=        # Slack app OAuth client secret
# SLACK_SIGNING_SECRET=       # Slack app signing secret (also signs the OAuth state)

# Inbound email replies (optional)
# EMAIL_INBOUND_SECRET=       # Shared secret for the inbound reply webhook; without it, replies are not auto-reflected

# Web search (optional — /api/search returns { disabled: true } without it)
# BRAVE_SEARCH_API_KEY=       # Brave Search API subscription token

# Telegram integration (optional as a complete group)
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_WEBHOOK_SECRET=

# Premise watcher (optional; requires Brave + Resend when enabled)
# PREMISE_WATCH_ENABLED=false
# PREMISE_WATCH_MAX_PER_RUN=200
# PREMISE_WATCH_MONTHLY_CAP=3000
