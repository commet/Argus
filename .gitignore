argus-plugin-v2/evals/report.json
argus-plugin-v2/evals/sweep-report.json

# scratch: bind/listen voyage shot harness output (never commit — large binaries)
.shots/

# Local-only Claude Code dev settings (per-developer; never commit)
.claude/settings.local.json

# Internal reference material (photos, third-party PDFs) — not for the public repo
/docs/참고/

# Design-sync experimentation scaffold (tool working dir)
/.design-sync/

# AI-dev exhaust & local Claude Code state — never commit (repo is public)
/.claude/projects/
/.claude/worktrees/
/.claude/skills/*/_*        # one-off scratch fragments (e.g. _writer.js, _test_write.txt)

# Borrowed/vendored non-Argus skill packs — not redistributed in this repo
/.agents/

# Internal design/strategy history — kept private, not in the public repo
/docs/archive/

# Supabase CLI link/runtime metadata
/supabase/.temp/
