# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/.artifacts/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch: visual-QA screenshots, shot/playwright scripts, dev logs (repo-root only)
/*.png
/dev.log
/shot*.mjs
/*-shot.mjs
# scratch: build-log captures and Playwright MCP page snapshots (dev-only, never commit)
/.post/
/.playwright-mcp/

# argus-watch + local working data: personal — never commit (repo is public)
/.argus/
/scripts/validation-output/
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules
.design-diag-shots/
.design-diag-dev.log
.design-sync/styles.css

# Argus eval run artifact
argus-plugin-v2/evals/report.json
argus-plugin-v2/evals/sweep-report.json

# scratch: bind/listen voyage shot harness output (never commit — large binaries)
.shots/

# Local-only Claude Code dev settings (per-developer; never commit)
.claude/settings.local.json

# Internal reference material (photos, third-party PDFs) — not for the public repo
/docs/참고/

# Design-sync experimentation scaffold (tool working dir)
/.design-sync/

# AI-dev exhaust & local Claude Code state — never commit (repo is public)
/.claude/projects/
/.claude/worktrees/
/.claude/skills/*/_*        # one-off scratch fragments (e.g. _writer.js, _test_write.txt)

# Borrowed/vendored non-Argus skill packs — not redistributed in this repo
/.agents/

# Internal design/strategy history — kept private, not in the public repo
/docs/archive/
