/scripts/dogfood/experience/shots/
/scripts/dogfood/experience/terminal-runs/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# scratch: visual-QA screenshots, shot/playwright scripts, dev logs (repo-root only)
/*.png
/dev.log
/shot*.mjs
/*-shot.mjs
# scratch: build-log captures and Playwright MCP page snapshots (dev-only, never commit)
/.post/
/.playwright-mcp/

# argus-watch + local working data: personal — never commit (repo is public)
/.argus/

# Private strategy/eval/roadmap notes — kept as local backup, never public (BLUEPRINT §3.3)
/docs/ARGUS-PRODUCT-EVALUATION-2026-07-16.ko.md
/docs/ARGUS-MCP-PLUGIN-OVERHAUL-REVIEW-2026-07-16.md
